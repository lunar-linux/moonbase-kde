          MODULE=kidletime
         VERSION=6.32.0
          SOURCE=$MODULE-$VERSION.tar.xz
      SOURCE_URL=$KDE_URL/stable/frameworks/$(module_version kf5)
      SOURCE_VFY=sha256:a7b53ff5a5f80bf8b8869b377de11594c9e5bccf84064c96efd6bab16974c1be
        WEB_SITE=https://projects.kde.org/projects/frameworks/kidletime
         ENTERED=20150205
         UPDATED=20261115
           SHORT="Reporting of idle time of user and system"

cat << EOF
KIdleTime is a singleton reporting information on idle time. It is useful not
only for finding out about the current idle time of the PC, but also for getting
notified upon idle time events, such as custom timeouts, or user activity.
EOF
