          MODULE=kidletime
         VERSION=6.30.0
          SOURCE=$MODULE-$VERSION.tar.xz
      SOURCE_URL=$KDE_URL/stable/frameworks/$(module_version kf5)
      SOURCE_VFY=sha256:22873204292ddb757e5a0a57004c57debe1285cd0fd4e796d07e9de2402e60c3
        WEB_SITE=https://projects.kde.org/projects/frameworks/kidletime
