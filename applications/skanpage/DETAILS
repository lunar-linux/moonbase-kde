          MODULE=skanpage
         VERSION=26.08.0
          SOURCE=$MODULE-$VERSION.tar.xz
      SOURCE_URL=$KDE_URL/stable/$MODULE/$VERSION
      SOURCE_VFY=sha256:a6e01169ee70f728720cdf7332c60380c29e0bcd2265d14ecff8575417d78f2e
        WEB_SITE=https://apps.kde.org/skanpage/
